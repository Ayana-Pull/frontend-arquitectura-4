# Port where Laravel (arquitectura-4) answers on the tenant domains. The API
# base is http(s)://<the host this app was opened on>:<port>/api, so opening
# http://demo.localhost:3000 talks to http://demo.localhost:8000/api.
VITE_API_PORT=8000

# Optional: a fixed API base with {tenant} replaced by the tenant subdomain,
# e.g. https://{tenant}.api.example.com/api. Overrides VITE_API_PORT.
# VITE_API_URL=

# Hosts that are not a tenant (Laravel's tenancy.central_domains).
VITE_CENTRAL_DOMAINS=localhost,127.0.0.1
